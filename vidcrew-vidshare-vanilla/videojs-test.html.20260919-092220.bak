<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video.js Test - Mux HLS + Captions</title>
    <link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
    <style>
        body { font-family: Arial; padding: 20px; background: #f5f5f5; }
        .container { max-width: 900px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; }
        .player-section { margin: 20px 0; }
        .video-container { margin: 20px 0; }
        .caption-list { margin-top: 20px; border: 1px solid #ddd; border-radius: 4px; max-height: 300px; overflow-y: auto; }
        .caption-item { padding: 8px 12px; border-bottom: 1px solid #eee; cursor: pointer; }
        .caption-item:hover { background: #f9f9f9; }
        .caption-item.active { background: #e3f2fd; border-left: 3px solid #1976d2; }
        .caption-time { font-weight: bold; color: #1976d2; }
        .caption-text { margin-top: 4px; color: #333; }
        .controls { margin: 15px 0; }
        .speed-control { margin: 10px 0; }
        label { font-weight: bold; margin-right: 10px; }
        input[type="range"], select { padding: 5px; }
        button { padding: 8px 16px; margin: 5px; cursor: pointer; }
        .info { font-size: 12px; color: #666; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Video.js + Mux HLS + Captions</h1>
        
        <div class="player-section">
            <div class="video-container">
                <video id="my-player" class="video-js vjs-default-skin" controls preload="auto" width="100%" height="400">
                    <source src="" type="application/x-mpegURL">
                    <p class="vjs-no-js">Enable JavaScript for video playback</p>
                </video>
            </div>
            
            <div class="caption-list" id="caption-list"></div>
        </div>

        <div class="controls">
            <h3>Playback Controls</h3>
            
            <div class="speed-control">
                <label for="speed-select">Playback Speed:</label>
                <select id="speed-select">
                    <option value="0.5">0.5x</option>
                    <option value="1" selected>1x (Normal)</option>
                    <option value="1.25">1.25x</option>
                    <option value="1.5">1.5x</option>
                    <option value="2">2x</option>
                </select>
            </div>

            <div>
                <label for="segment-start">Segment Start (sec):</label>
                <input type="number" id="segment-start" value="0" min="0" step="0.1">
                
                <label for="segment-end">Segment End (sec):</label>
                <input type="number" id="segment-end" value="0" min="0" step="0.1">
                
                <button onclick="applySegment()">Apply Segment</button>
                <button onclick="resetSegment()">Reset Segment</button>
            </div>
        </div>

        <div class="info">
            <p><strong>Mux Playback ID:</strong> SvqqQy00F02XjvoHso00quQnXvhDqspUyfmn2uJoUqUIFU</p>
            <p><strong>HLS Stream URL:</strong> <code id="stream-url">https://stream.mux.com/SvqqQy00F02XjvoHso00quQnXvhDqspUyfmn2uJoUqUIFU.m3u8</code></p>
            <p id="status">Status: Loading...</p>
            <p id="current-time">Current time: 0s</p>
        </div>
    </div>

    <script src="https://vjs.zencdn.net/7.20.3/video.js"></script>
    <script>
        const playbackId = 'SvqqQy00F02XjvoHso00quQnXvhDqspUyfmn2uJoUqUIFU';
        const hlsUrl = `https://stream.mux.com/${playbackId}.m3u8`;
        const vttUrl = 'https://chunk-oci-us-ashburn-1-vop1.fastly.mux.com/v1/subtitle/VVVcQn7VWndhuINWjbsMzMV8tb8EaIMDn2SlwgOBwkHz3yTK5UZjCgo1cjKa8qz2gbvFesLqbcFX4wGATSkqvCwBgbvhLYf01/0.vtt?skid=default&signature=NmFiNmVlZTBfZWEyZGU3YWJjNTUxOGVkOTZhZDljNGYzNWFlMjRlYjMzNDZkOGM5NzU5OTJhNDZiNmVkODVhOGQwZWUxMjQ0MQ==';
        
        let allCues = [];
        let player;

        // Initialize Video.js player
        player = videojs('my-player', {
            controls: true,
            autoplay: false,
            preload: 'auto',
            responsive: true,
            fluid: true
        });

        // Set HLS source
        player.src({
            src: hlsUrl,
            type: 'application/x-mpegURL'
        });

        // Parse VTT and add cues to track
        async function loadAndInjectCaptions() {
            try {
                const response = await fetch(vttUrl);
                const vttText = await response.text();
                
                // Create text track
                const track = player.addTextTrack('captions', 'English', 'en');
                
                // Parse VTT and add cues
                parseCuesFromVTT(vttText, track);
                
                // Build caption list UI
                renderCaptionList();
                
                console.log('Captions loaded: ' + allCues.length + ' cues');
            } catch (e) {
                console.error('Error loading captions:', e);
                document.getElementById('status').textContent = 'Status: Error loading captions ✗';
            }
        }
        
        function parseCuesFromVTT(vttText, track) {
            const lines = vttText.split('\n');
            let i = 0;
            
            while (i < lines.length) {
                const line = lines[i].trim();
                
                if (line.includes('-->')) {
                    const [startStr, endStr] = line.split('-->').map(t => t.trim());
                    const start = timeToSeconds(startStr);
                    const end = timeToSeconds(endStr);
                    
                    i++;
                    let text = '';
                    while (i < lines.length && lines[i].trim() !== '') {
                        text += lines[i].trim() + ' ';
                        i++;
                    }
                    
                    if (text.trim()) {
                        const cue = new VTTCue(start, end, text.trim());
                        track.addCue(cue);
                        allCues.push({ start, end, text: text.trim() });
                    }
                }
                i++;
            }
        }
        
        function timeToSeconds(timeStr) {
            const parts = timeStr.split(':');
            const hours = parseInt(parts[0]) || 0;
            const minutes = parseInt(parts[1]) || 0;
            const seconds = parseFloat(parts[2]) || 0;
            return hours * 3600 + minutes * 60 + seconds;
        }
        
        function formatTime(seconds) {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = Math.floor(seconds % 60);
            return `${h > 0 ? h + ':' : ''}${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }
        
        function renderCaptionList() {
            const list = document.getElementById('caption-list');
            list.innerHTML = '';
            
            allCues.forEach((cue, idx) => {
                const item = document.createElement('div');
                item.className = 'caption-item';
                item.id = 'caption-' + idx;
                item.innerHTML = `
                    <div class="caption-time">${formatTime(cue.start)} → ${formatTime(cue.end)}</div>
                    <div class="caption-text">${cue.text}</div>
                `;
                item.addEventListener('click', () => {
                    player.currentTime(cue.start);
                    player.play();
                });
                list.appendChild(item);
            });
        }
        
        function updateActiveCue(currentTime) {
            // Clear all active
            document.querySelectorAll('.caption-item.active').forEach(el => {
                el.classList.remove('active');
            });
            
            // Find and highlight current cue
            const current = allCues.findIndex(cue => currentTime >= cue.start && currentTime <= cue.end);
            if (current >= 0) {
                const el = document.getElementById('caption-' + current);
                if (el) {
                    el.classList.add('active');
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }
        }

        // Load captions immediately
        loadAndInjectCaptions();

        // Load metadata
        player.on('loadedmetadata', function() {
            document.getElementById('status').textContent = 'Status: Ready to play ✓';
            const duration = player.duration();
            document.getElementById('segment-end').value = duration.toFixed(1);
        });

        player.on('error', function() {
            document.getElementById('status').textContent = 'Status: Error loading video ✗';
        });

        // Update current time and active caption
        player.on('timeupdate', function() {
            const current = player.currentTime();
            document.getElementById('current-time').textContent = `Current time: ${current.toFixed(1)}s`;
            updateActiveCue(current);
        });

        // Speed control
        document.getElementById('speed-select').addEventListener('change', function(e) {
            player.playbackRate(parseFloat(e.target.value));
        });

        // Segment controls
        let segmentActive = false;
        let segmentEnd = 0;

        function applySegment() {
            const start = parseFloat(document.getElementById('segment-start').value);
            const end = parseFloat(document.getElementById('segment-end').value);
            
            if (isNaN(start) || isNaN(end) || start >= end) {
                alert('Invalid segment times');
                return;
            }
            
            player.currentTime(start);
            segmentEnd = end;
            segmentActive = true;
            player.play();
            document.getElementById('status').textContent = `Segment active: ${start}s - ${end}s`;
        }

        function resetSegment() {
            segmentActive = false;
            document.getElementById('status').textContent = 'Status: Ready to play ✓';
        }

        // Auto-pause at segment end
        player.on('timeupdate', function() {
            if (segmentActive && player.currentTime() >= segmentEnd) {
                player.pause();
                document.getElementById('status').textContent = 'Segment ended. Paused.';
            }
        });
    </script>
</body>
</html>
